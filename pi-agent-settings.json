{
  "lastChangelogVersion": "1.0.4",
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "defaultTools": [
    "+codemode"
  ],
  "enabledModels": [
    "openai/gpt-6.1-sol",
    "openai/gpt-6-luna",
    "openai/gpt-6-astra"
  ],
  "packages": [
    "npm:@plannotator/pi-extension"
