{{- /* chezmoi:modify-template */ -}}

{{- /* Parse the current file, or start with an empty object on a fresh machine.
      Chezmoi renders this template natively; it is not executed as a script. */}}
{{- $settings := .chezmoi.stdin | trim | default "{}" | fromJson }}
{{- if not (kindIs "map" $settings) }}
  {{- fail "Pi settings must be a JSON object" }}
{{- end }}

{{- /* Seed only missing fields. Never seed Pi-owned state such as
      lastChangelogVersion or overwrite explicit false values and empty arrays. */}}
{{- $work := .work_laptop }}
{{- $defaults := fromJson `{
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "defaultTools": ["+codemode"],
  "enabledModels": [
    "openai/gpt-6.1-sol",
    "openai/gpt-6-luna",
    "openai/gpt-6-astra"
  ],
  "steeringMode": "one-at-a-time",
  "followUpMode": "one-at-a-time",
  "enableInstallTelemetry": false,
  "hideThinkingBlock": false,
  "compaction": {"enabled": true},
  "npmCommand": ["pnpm"],
  "theme": "dark",
  "showCacheMissNotices": true,
  "tuiMode": "regular"
}` }}
{{- range $key, $value := $defaults }}
  {{- if not (hasKey $settings $key) }}
    {{- $_ := set $settings $key $value }}
  {{- end }}
{{- end }}

{{- /* Use a Lunar model by default on work machines; restore the managed
      OpenAI default when a Lunar configuration is rendered for personal use. */}}
{{- $lunarModels := list "anthropic.claude-haiku-5-5" "anthropic.claude-opus-5-5" "anthropic.claude-sonnet-5-5" "auto" "gpt-6-astra" "gpt-6-luna" "gpt-6.1-sol" "lunar-anthropic-auto" }}
{{- $openaiModels := list "gpt-6.1-sol" "gpt-6-luna" "gpt-6-astra" }}
{{- if $work }}
  {{- $_ := set $settings "defaultProvider" "lunar" }}
  {{- if not (has $settings.defaultModel $lunarModels) }}
    {{- $_ := set $settings "defaultModel" "gpt-6.1-sol" }}
  {{- end }}
{{- else if eq $settings.defaultProvider "lunar" }}
  {{- $_ := set $settings "defaultProvider" "openai" }}
  {{- if not (has $settings.defaultModel $openaiModels) }}
    {{- $_ := set $settings "defaultModel" "gpt-6.1-sol" }}
  {{- end }}
{{- end }}

{{- /* Remove the former third-party Plannotator Pi extension. Keep unrelated
      packages, and keep the Lunar provider only at work. */}}
{{- $provider := "npm:@lunarway/pi-lunar-litellm" }}
{{- $providerPattern := printf "^%s(@.*)?$" $provider }}
{{- $plannotatorPattern := "^npm:@plannotator/pi-extension(@.*)?$" }}
{{- $packages := list }}
{{- $hasProvider := false }}
{{- $existingPackages := get $settings "packages" | default (list) }}
{{- range $package := $existingPackages }}
  {{- $source := $package }}
  {{- if kindIs "map" $package }}
    {{- $source = $package.source }}
  {{- end }}
  {{- $isProvider := regexMatch $providerPattern $source }}
  {{- $isPlannotator := regexMatch $plannotatorPattern $source }}
  {{- $hasProvider = or $hasProvider $isProvider }}
  {{- if and (not $isPlannotator) (or (not $isProvider) $work) }}
    {{- $packages = append $packages $package }}
  {{- end }}
{{- end }}
{{- if and $work (not $hasProvider) }}
  {{- $packages = append $packages $provider }}
{{- end }}
{{- $_ := set $settings "packages" $packages }}

{{- /* Load the locally maintained Plannotator bridge only on Lunar machines.
      It lives outside the auto-discovered extensions directory. */}}
{{- $plannotatorExtension := "./local-extensions/plannotator/index.ts" }}
{{- $extensions := list }}
{{- $existingExtensions := get $settings "extensions" | default (list) }}
{{- range $extension := $existingExtensions }}
  {{- if ne $extension $plannotatorExtension }}
    {{- $extensions = append $extensions $extension }}
  {{- end }}
{{- end }}
{{- if $work }}
  {{- $extensions = append $extensions $plannotatorExtension }}
{{- end }}
{{- $_ := set $settings "extensions" $extensions }}
{{- /* Work machines expose only Lunar models. Personal configs retain their
      existing choices, apart from the work-only Lunar wildcard. */}}
{{- $scope := "lunar/*" }}
{{- $models := list }}
{{- if $work }}
  {{- range $model := $settings.enabledModels }}
    {{- if and (hasPrefix "lunar/" $model) (ne $model $scope) (not (has $model $models)) }}
      {{- $models = append $models $model }}
    {{- end }}
  {{- end }}
  {{- $models = append $models $scope }}
{{- else }}
  {{- $models = without $settings.enabledModels $scope }}
{{- end }}
{{- $_ := set $settings "enabledModels" $models }}

{{- /* Emit the replacement JSON, retaining every other existing field. */}}
{{- $settings | toPrettyJson }}
